# Credenciales API SUNAT (Menú SOL > Empresas > Credenciales de API SUNAT)
SUNAT_CLIENT_ID=tu-client-id
SUNAT_CLIENT_SECRET=tu-client-secret

# Datos de la empresa y usuario secundario SOL con perfil SIRE
SUNAT_RUC=20XXXXXXXXX
SUNAT_USUARIO_SOL=USUARIO1
SUNAT_CLAVE_SOL=tu-clave-sol

# Opcional: credenciales distintas para la API "Consulta de validez de CPE"
# (si no se indican, se usan las de arriba)
# SUNAT_VALIDEZ_CLIENT_ID=
# SUNAT_VALIDEZ_CLIENT_SECRET=
